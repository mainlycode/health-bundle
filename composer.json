{
    "name": "mainlycode/health-bundle",
    "description": "Symfony bundle for adding a /health endpoint to your application",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "othillo",
            "email": "othillo@othillo.nl"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/http-foundation": "^6.4||^7.4||^8.1"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5||^12.5||^13.0",
        "symfony/browser-kit": "^6.4||^7.4||^8.1",
        "symfony/framework-bundle": "^6.4||^7.4||^8.1",
        "symfony/runtime": "^6.4||^7.4||^8.1",
        "symfony/yaml": "^6.4||^7.4||^8.1"
    },
    "autoload": {
        "psr-4": {
            "MainlyCode\\HealthBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MainlyCode\\HealthBundle\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
